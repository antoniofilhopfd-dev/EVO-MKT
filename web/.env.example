# Copie as variáveis abaixo para o painel da Hostinger (Node.js Web App → Variáveis de ambiente).
# NUNCA coloque valores reais neste arquivo nem no repositório.
NODE_ENV=production

# Banco MySQL da Hostinger (hPanel → Bancos de dados)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Gere com: npm run gerar:segredos
SESSION_SECRET=
APP_KEY=
SETUP_KEY=

# Endereço público do sistema (sem barra no final)
PUBLIC_URL=https://evomkt.antoniopfd.com

# Avisos por e-mail (opcional). Sem SMTP o sistema só registra no log.
NOTIFY_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Opcionais (valores padrão entre parênteses)
# TIMEZONE=America/Fortaleza
# SESSION_HOURS=12
# BACKUP_KEEP=30
# MAX_UPLOAD_MB=15
# LOGIN_IP_MAX=10
# LOGIN_GLOBAL_MAX=150
# LOGIN_DELAY_MS=300

# Só se for usar os avisos agendados (cron) e as sincronizações
CRON_SECRET=

# Quantos proxies confiáveis existem na frente do app (define de onde sai o IP do cliente em X-Forwarded-For). Hostinger: 1.
# TRUSTED_PROXY_HOPS=1

# Regras de prazo e carga (opcionais)
# FERIADOS=2026-11-15,2026-11-20      # datas AAAA-MM-DD que não contam como dia útil no SLA
# LIMITE_SOBRECARGA=8                 # itens abertos por pessoa antes de marcar sobrecarga

# IA para rascunhos de legenda (opcional; a chave também pode ser salva em Administração → Integrações)
# ANTHROPIC_API_KEY=
# IA_MODEL=claude-opus-5-5

# Somente depois da instalação/recuperação: REMOVA do painel (a tela de Prontidão avisa)
# SETUP_KEY e RECOVERY_KEY liberam rotas de diagnóstico, instalação e recuperação de acesso.
# RECOVERY_KEY=
